# ============================================================================
# Antigen environment template  —  copy to `.env` and fill in.
#
# NOTE: NONE of this is needed for the offline proof. `python verify.py`,
# `python -m antigen demo --offline`, `bench.py`, and the whole test suite run
# with ZERO configuration. These variables are ONLY for:
#   (a) the LIVE path against a real DataHub GMS  (DATAHUB_* + the tool flags)
#   (b) the victim-agent hijack demo, verify.py Part B  (the LLM key)
# ============================================================================


# ── DataHub — live path (needed only for `./run.sh live`, seed_corpus.py) ────

# DATAHUB_GMS_URL — the GMS (backend) endpoint Antigen talks to.
#   What:  a URL. Default is correct for a local quickstart; no need to change it.
#   How:   start a free local DataHub — `datahub docker quickstart`
#          (GMS on :8080, UI on :9002; needs Docker + Python 3.10+, ~8 GB RAM).
#   Docs:  https://docs.datahub.com/docs/quickstart
DATAHUB_GMS_URL=http://localhost:8080

# DATAHUB_GMS_TOKEN — a DataHub Personal Access Token (PAT), for auth.
#   Where: DataHub UI → http://localhost:9002 → your avatar → Settings →
#          "Access Tokens" → "Generate new token" → copy it (shown once).
#   Note:  local quickstart has auth enabled by default; if "Access Tokens" is
#          missing, set METADATA_SERVICE_AUTH_ENABLED=true on the GMS and restart.
#   Docs:  https://docs.datahub.com/docs/authentication/personal-access-tokens
DATAHUB_GMS_TOKEN=your-datahub-personal-access-token


# ── mcp-server-datahub tool flags (self-hosted) ─────────────────────────────
# These are NOT secrets you fetch anywhere — they are on/off toggles YOU set in
# the shell/env where the self-hosted MCP server (`uvx mcp-server-datahub@latest`)
# or the Agent Context Kit runs. Keep the values below so Antigen's 4 write-back
# tools + the KB-document overwrite all work.
#   Docs:  https://github.com/acryldata/mcp-server-datahub  (config env vars)
TOOLS_IS_MUTATION_ENABLED=true        # enables the 4 mutation tools (update_description, add_tags, …)
SAVE_DOCUMENT_TOOL_ENABLED=true       # enables the forensic KB-document tool
SAVE_DOCUMENT_RESTRICT_UPDATES=false  # lets the 2 doc-locus cures overwrite an existing doc in place


# ── Victim-agent hijack demo (verify.py Part B — reported, never gates) ──────

# ANTIGEN_DEMO_MODEL — which LLM the stock "victim" agent uses.
#   What:  a model-id STRING (not fetched anywhere) — pick one your key supports.
#   Claude ids:  claude-sonnet-5 · claude-opus-4-8 · claude-haiku-4-5-20251001
#                (see https://docs.anthropic.com/en/docs/about-claude/models)
#   OpenAI ids:  gpt-4o · gpt-4o-mini · o4-mini  (a "claude-*" id uses the
#                Anthropic key below; anything else uses OPENAI_API_KEY)
ANTIGEN_DEMO_MODEL=claude-sonnet-5

# ANTHROPIC_API_KEY — used when ANTIGEN_DEMO_MODEL starts with "claude".
#   Where: https://console.anthropic.com/settings/keys → "Create Key" → copy.
#          (Requires an Anthropic account with billing/credits enabled.)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPENAI_API_KEY — used when ANTIGEN_DEMO_MODEL is an OpenAI id. Uncomment to use.
#   Where: https://platform.openai.com/api-keys → "Create new secret key" → copy.
# OPENAI_API_KEY=sk-your-key-here
